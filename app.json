{
  "expo": {
    "name": "Wojhat Travel | وجهات للسفر",
    "slug": "wojhat-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1926"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.com.wojhat.travel",
      "infoPlist": {
        "CFBundleDisplayName": "Wojhat",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tel",
          "mailto",
          "https"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1926"
      },
      "package": "sa.com.wojhat.travel",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CALL_PHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": []
  }
}
